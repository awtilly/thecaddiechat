rules_version = '2';

// Security rules for the Task Command app (project: todolist-6ca86).
// The app signs in every visitor anonymously and shares one dataset
// (tasks collection + meta/* docs). These rules grant access to any
// authenticated user — including anonymous auth — and to nothing else.
//
// IMPORTANT: do NOT replace this with a time-limited "test mode" rule.
// Test-mode rules expire ~30 days after creation and silently break
// sync (every read/write returns PERMISSION_DENIED). That expiry is
// exactly what broke sync before this file existed.

service cloud.firestore {
  match /databases/{database}/documents {

    // Tasks: one document per task, keyed by task id.
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // App metadata: projects, people, aliases, config.
    match /meta/{docId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
