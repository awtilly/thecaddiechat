---
import PageLayout from '../../layouts/PageLayout.astro';
import PostListing from '../../components/PostListing.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { getCollection } from 'astro:content';

const allChronicles = await getCollection('chronicles');
// Entries with draft: true are never shown in the main listing
const chronicles = allChronicles
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<PageLayout
  title="Chronicles | The Caddie Chat"
  description="First-person stories from inside the ropes: caddying for PGA Tour pros at charity pro-ams."
  pageTitle="Chronicles"
  pageSubtitle="First-person stories from caddying for PGA Tour pros at charity pro-ams, and the moments between the shots that most people never see."
  sectionLabel="Inside the Ropes"
>
  <PostListing posts={chronicles} basePath="/chronicles/" />

  <CtaBanner
    heading='More stories <em>coming.</em>'
    description="The bag isn't down yet. Follow along for new chronicles from inside the ropes."
    buttonText="Follow on Instagram"
    buttonHref="https://instagram.com/thecaddiechat"
    buttonExternal={true}
  />
</PageLayout>
