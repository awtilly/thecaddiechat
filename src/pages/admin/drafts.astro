---
/**
 * /admin/drafts — local-only draft review page.
 *
 * In production (npm run build / GitHub Pages) this renders a bare 404 stub
 * with no draft content. The functional UI only runs in dev (npm run dev).
 *
 * Usage:
 *   1. npm run dev
 *   2. Open http://localhost:4321/admin/drafts/
 *   3. Review drafts, click Publish or Discard
 *   4. git push when you're happy with the result
 */
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const isProd = import.meta.env.PROD;

type DraftEntry = {
  id: string;
  title: string;
  date: Date;
  description: string;
  sourceUrl?: string;
  sourcesConsidered?: string[];
  bodyPreview: string;
};

let drafts: DraftEntry[] = [];

if (!isProd) {
  const all = await getCollection('chronicles');
  for (const entry of all
    .filter((e) => e.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())) {
    let bodyPreview = '(could not read body)';
    try {
      const filePath = join(process.cwd(), 'src/content/chronicles', `${entry.id}.mdx`);
      const raw = readFileSync(filePath, 'utf-8');
      // Find the end of the frontmatter block (second ---)
      const firstClose = raw.indexOf('---', 3);
      if (firstClose !== -1) {
        bodyPreview = raw.slice(firstClose + 3).trim().slice(0, 300);
      }
    } catch {
      // leave default
    }
    drafts.push({
      id: entry.id,
      title: entry.data.title,
      date: entry.data.date,
      description: entry.data.description,
      sourceUrl: entry.data.sourceUrl,
      sourcesConsidered: entry.data.sourcesConsidered,
      bodyPreview,
    });
  }
}
---

{isProd ? (
  <html lang="en">
    <head><meta charset="UTF-8" /><title>Not Found</title></head>
    <body style="font-family:sans-serif;padding:2rem;color:#666;">
      <p>Not found.</p>
    </body>
  </html>
) : (
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>Draft Review — The Caddie Chat</title>
      <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
          background: #f5f4f2;
          color: #1a1a1a;
          margin: 0;
          padding: 2rem;
          line-height: 1.5;
        }
        .page-header {
          max-width: 900px;
          margin: 0 auto 2rem;
          border-bottom: 2px solid #2d5a3f;
          padding-bottom: 1rem;
        }
        .page-header h1 {
          font-size: 1.5rem;
          font-weight: 600;
          margin: 0 0 0.25rem;
          color: #2d5a3f;
        }
        .page-header p {
          margin: 0;
          font-size: 0.85rem;
          color: #666;
        }
        .empty-state {
          max-width: 900px;
          margin: 3rem auto;
          text-align: center;
          color: #888;
          font-size: 1rem;
        }
        .draft-card {
          max-width: 900px;
          margin: 0 auto 1.5rem;
          background: #fff;
          border: 1px solid #ddd;
          border-radius: 4px;
          overflow: hidden;
        }
        .draft-card-header {
          background: #fafaf9;
          border-bottom: 1px solid #eee;
          padding: 1rem 1.25rem;
          display: flex;
          align-items: baseline;
          gap: 1rem;
          flex-wrap: wrap;
        }
        .draft-title {
          font-size: 1.05rem;
          font-weight: 600;
          flex: 1;
          min-width: 200px;
        }
        .draft-meta {
          font-size: 0.78rem;
          color: #888;
          white-space: nowrap;
        }
        .draft-badge {
          font-size: 0.7rem;
          font-weight: 700;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          background: #f0c040;
          color: #5a3e00;
          padding: 0.2em 0.5em;
          border-radius: 3px;
        }
        .draft-card-body {
          padding: 1rem 1.25rem;
        }
        .draft-description {
          font-size: 0.9rem;
          color: #444;
          margin: 0 0 0.75rem;
        }
        .draft-preview {
          font-size: 0.82rem;
          color: #666;
          background: #f8f8f7;
          border-left: 3px solid #ddd;
          padding: 0.6rem 0.8rem;
          margin: 0 0 0.75rem;
          font-family: 'Courier New', monospace;
          white-space: pre-wrap;
          word-break: break-word;
        }
        .draft-source {
          font-size: 0.8rem;
          color: #888;
          margin: 0 0 0.5rem;
        }
        .draft-source a {
          color: #2d5a3f;
        }
        .draft-sources-list {
          font-size: 0.78rem;
          color: #aaa;
          margin: 0;
          padding-left: 1.2rem;
        }
        .draft-sources-list li { margin-bottom: 0.2rem; }
        .draft-card-actions {
          padding: 0.75rem 1.25rem;
          border-top: 1px solid #eee;
          display: flex;
          gap: 0.75rem;
          align-items: center;
          background: #fafaf9;
        }
        .btn {
          padding: 0.45rem 1rem;
          font-size: 0.82rem;
          font-weight: 600;
          border: none;
          border-radius: 3px;
          cursor: pointer;
          transition: opacity 0.15s;
        }
        .btn:hover { opacity: 0.85; }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-preview {
          background: #e8f0eb;
          color: #2d5a3f;
          text-decoration: none;
          display: inline-block;
        }
        .btn-publish {
          background: #2d5a3f;
          color: #fff;
        }
        .btn-discard {
          background: #fee;
          color: #c00;
        }
        .action-status {
          font-size: 0.8rem;
          color: #888;
          margin-left: auto;
        }
        .action-status.error { color: #c00; }
        .action-status.success { color: #2d5a3f; }
      </style>
    </head>
    <body>
      <div class="page-header">
        <h1>Draft Review</h1>
        <p>
          {drafts.length === 0
            ? 'No drafts pending.'
            : `${drafts.length} draft${drafts.length === 1 ? '' : 's'} pending review.`}
          &nbsp;Publish commits locally. <strong>git push</strong> when ready to deploy.
        </p>
      </div>

      {drafts.length === 0 && (
        <div class="empty-state">
          <p>No drafts found. The scheduled task will add new ones each Sunday.</p>
        </div>
      )}

      {drafts.map((draft) => (
        <div class="draft-card" id={`draft-${draft.id}`}>
          <div class="draft-card-header">
            <span class="draft-badge">Draft</span>
            <span class="draft-title">{draft.title}</span>
            <span class="draft-meta">
              {draft.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              &nbsp;&middot;&nbsp; <code>{draft.id}</code>
            </span>
          </div>
          <div class="draft-card-body">
            <p class="draft-description">{draft.description}</p>
            <div class="draft-preview">{draft.bodyPreview}{draft.bodyPreview.length === 300 ? '…' : ''}</div>
            {draft.sourceUrl && (
              <p class="draft-source">
                Source: <a href={draft.sourceUrl} target="_blank" rel="noopener">{draft.sourceUrl}</a>
              </p>
            )}
            {draft.sourcesConsidered && draft.sourcesConsidered.length > 0 && (
              <ul class="draft-sources-list">
                {draft.sourcesConsidered.map((url) => (
                  <li><a href={url} target="_blank" rel="noopener">{url}</a></li>
                ))}
              </ul>
            )}
          </div>
          <div class="draft-card-actions">
            <a
              href={`/chronicles/${draft.id}/`}
              target="_blank"
              class="btn btn-preview"
            >Preview &rarr;</a>
            <button
              class="btn btn-publish"
              data-slug={draft.id}
              data-action="publish"
            >Publish</button>
            <button
              class="btn btn-discard"
              data-slug={draft.id}
              data-action="discard"
            >Discard</button>
            <span class="action-status" id={`status-${draft.id}`}></span>
          </div>
        </div>
      ))}

      <script>
        async function handleDraftAction(slug: string, action: string) {
          const statusEl = document.getElementById(`status-${slug}`);
          const card = document.getElementById(`draft-${slug}`);
          const buttons = card?.querySelectorAll<HTMLButtonElement>('.btn-publish, .btn-discard');

          if (statusEl) {
            statusEl.textContent = action === 'publish' ? 'Publishing…' : 'Discarding…';
            statusEl.className = 'action-status';
          }
          buttons?.forEach((b) => (b.disabled = true));

          try {
            const res = await fetch('/api/publish-draft', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug, action }),
            });
            const data = await res.json();
            if (data.ok) {
              if (statusEl) {
                statusEl.textContent = data.message;
                statusEl.className = 'action-status success';
              }
              // Remove the card from the page after a brief pause
              setTimeout(() => card?.remove(), 800);
            } else {
              if (statusEl) {
                statusEl.textContent = `Error: ${data.error}`;
                statusEl.className = 'action-status error';
              }
              buttons?.forEach((b) => (b.disabled = false));
            }
          } catch (err) {
            if (statusEl) {
              statusEl.textContent = 'Network error — is npm run dev still running?';
              statusEl.className = 'action-status error';
            }
            buttons?.forEach((b) => (b.disabled = false));
          }
        }

        document.querySelectorAll<HTMLButtonElement>('.btn-publish, .btn-discard').forEach((btn) => {
          btn.addEventListener('click', () => {
            const slug = btn.dataset.slug!;
            const action = btn.dataset.action!;
            if (action === 'discard') {
              if (!confirm(`Discard "${slug}"?\n\nThis deletes the file and commits the removal.`)) return;
            }
            handleDraftAction(slug, action);
          });
        });
      </script>
    </body>
  </html>
)}
