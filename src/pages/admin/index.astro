---
// /admin/ — cloud-based draft review for The Caddie Chat.
// Static Astro page — all logic is client-side.
// Security: password verified by the Firebase function (functions/index.js).
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Admin — The Caddie Chat</title>

  <!--
    is:global — fixes the HTML `hidden` attribute being overridden by the
    author stylesheet (Astro scoped CSS gains higher specificity than the
    UA `[hidden] { display: none }`).
  -->
  <style is:global>
    [hidden] { display: none !important; }

    /*
      Card styles are global because the cards are injected via innerHTML
      and therefore lack the Astro data-cid attribute needed for scoped CSS.
    */
    .loading-state,
    .empty-state,
    .error-msg {
      text-align: center;
      color: var(--muted);
      font-size: 0.95rem;
      padding: 3rem 1rem;
    }
    .error-msg { color: var(--danger); }

    .draft-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      margin-bottom: 1.25rem;
    }

    .card-header {
      background: #fafaf9;
      border-bottom: 1px solid #eee;
      padding: 0.9rem 1.1rem;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem 0.75rem;
    }

    .draft-badge {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: #f0c040;
      color: #5a3e00;
      padding: 0.2em 0.5em;
      border-radius: 3px;
      flex-shrink: 0;
    }

    .card-title {
      font-size: 1rem;
      font-weight: 600;
      flex: 1;
      min-width: 180px;
      margin: 0;
    }

    .card-meta {
      font-size: 0.75rem;
      color: var(--muted);
      white-space: nowrap;
    }

    .card-body { padding: 0.9rem 1.1rem; }

    .card-desc {
      font-size: 0.88rem;
      color: #444;
      margin: 0 0 0.7rem;
    }

    .card-preview {
      font-size: 0.78rem;
      font-family: 'Courier New', monospace;
      color: #555;
      background: #f8f8f7;
      border-left: 3px solid var(--border);
      padding: 0.6rem 0.8rem;
      white-space: pre-wrap;
      word-break: break-word;
      margin: 0 0 0.7rem;
    }

    .card-source {
      font-size: 0.78rem;
      color: var(--muted);
      word-break: break-all;
      margin: 0;
    }
    .card-source a { color: #2d5a3f; }

    .card-actions {
      padding: 0.7rem 1.1rem;
      border-top: 1px solid #eee;
      background: #fafaf9;
      display: flex;
      gap: 0.6rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .admin-btn {
      padding: 0.45rem 1rem;
      font-size: 0.82rem;
      font-weight: 600;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: opacity 0.15s;
      white-space: nowrap;
      text-decoration: none;
      display: inline-block;
      line-height: 1.4;
    }
    .admin-btn:hover { opacity: 0.85; }
    .admin-btn:disabled { opacity: 0.45; cursor: not-allowed; }

    .btn-preview  { background: #e8f0eb; color: #2d5a3f; }
    .btn-publish  { background: #2d5a3f; color: #fff; }
    .btn-discard  { background: #fee; color: #c00; }

    .card-status {
      font-size: 0.78rem;
      color: var(--muted);
      margin-left: auto;
    }
    .card-status.success { color: #2d5a3f; }
    .card-status.error   { color: #c00; }

    @media (max-width: 500px) {
      .card-header, .card-body { padding: 0.75rem 0.9rem; }
      .card-actions { padding: 0.6rem 0.9rem; }
      .card-title { font-size: 0.95rem; }
      .admin-btn { padding: 0.5rem 0.85rem; }
    }
  </style>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green: #2d5a3f;
      --cream: #f5f4f2;
      --border: #ddd;
      --text: #1a1a1a;
      --muted: #666;
      --danger: #c00;
      --danger-bg: #fee;
      --radius: 6px;
      --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    body {
      font-family: var(--font);
      background: var(--cream);
      color: var(--text);
      line-height: 1.5;
      min-height: 100vh;
    }

    /* ── Gate ───────────────────────────────────────────── */
    #gate {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .gate-card {
      width: 100%;
      max-width: 360px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem 1.75rem;
    }

    .gate-logo {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--green);
      margin-bottom: 1.25rem;
    }

    .gate-card h1 {
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    .gate-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--muted);
      margin-bottom: 0.4rem;
    }

    .gate-input {
      width: 100%;
      padding: 0.65rem 0.85rem;
      font-size: 1rem;
      font-family: var(--font);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: #fff;
      color: var(--text);
      outline: none;
      transition: border-color 0.15s;
      margin-bottom: 0.9rem;
    }
    .gate-input:focus { border-color: var(--green); }

    .gate-btn {
      width: 100%;
      padding: 0.65rem 1rem;
      font-size: 0.9rem;
      font-weight: 600;
      font-family: var(--font);
      background: var(--green);
      color: #fff;
      border: none;
      border-radius: var(--radius);
      cursor: pointer;
      transition: opacity 0.15s;
    }
    .gate-btn:hover { opacity: 0.88; }
    .gate-btn:active { opacity: 0.75; }

    .gate-error {
      margin-top: 0.75rem;
      font-size: 0.82rem;
      color: var(--danger);
      text-align: center;
    }

    /* ── App shell ──────────────────────────────────────── */
    #app { display: flex; flex-direction: column; min-height: 100vh; }

    .app-header {
      background: #fff;
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.25rem;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .app-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      max-width: 900px;
      margin: 0 auto;
    }

    .app-header h1 {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--green);
    }

    .lock-btn {
      font-size: 0.78rem;
      font-weight: 600;
      font-family: var(--font);
      background: none;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.3rem 0.75rem;
      color: var(--muted);
      cursor: pointer;
      transition: border-color 0.15s, color 0.15s;
      white-space: nowrap;
    }
    .lock-btn:hover { border-color: #aaa; color: var(--text); }

    .app-subtitle {
      font-size: 0.8rem;
      color: var(--muted);
      max-width: 900px;
      margin: 0.3rem auto 0;
    }

    .app-main {
      flex: 1;
      padding: 1.5rem 1.25rem;
      max-width: 900px;
      width: 100%;
      margin: 0 auto;
    }

    /* ── Toast ──────────────────────────────────────────── */
    /*
      Use bottom-based show/hide instead of translateY(%) — the % is relative
      to the element's own height, which made the math unreliable for short
      empty elements (causing a partial black bar to show at the viewport edge).
    */
    .toast {
      position: fixed;
      bottom: -5rem;
      left: 50%;
      transform: translateX(-50%);
      background: #1a1a1a;
      color: #fff;
      padding: 0.65rem 1.25rem;
      border-radius: var(--radius);
      font-size: 0.85rem;
      font-weight: 500;
      max-width: calc(100vw - 2rem);
      white-space: normal;
      text-align: center;
      transition: bottom 0.25s ease;
      z-index: 100;
      pointer-events: none;
    }
    .toast.toast--visible { bottom: 1.5rem; }
    .toast.toast--error { background: var(--danger); }
  </style>
</head>
<body>

  <!-- ── Password gate ───────────────────────────────── -->
  <div id="gate">
    <div class="gate-card">
      <div class="gate-logo">The Caddie Chat</div>
      <h1>Draft Review</h1>
      <form id="gate-form" autocomplete="off" novalidate>
        <label for="pw-input" class="gate-label">Admin Password</label>
        <input
          type="password"
          id="pw-input"
          class="gate-input"
          autocomplete="current-password"
          placeholder="••••••••"
          autofocus
        />
        <button type="submit" class="gate-btn">Unlock →</button>
        <p id="gate-err" class="gate-error" hidden></p>
      </form>
    </div>
  </div>

  <!-- ── App (shown only after password submitted) ──── -->
  <div id="app" hidden>
    <header class="app-header">
      <div class="app-header-row">
        <h1>Draft Review</h1>
        <button id="lock-btn" class="lock-btn">Lock</button>
      </div>
      <p id="app-subtitle" class="app-subtitle"></p>
    </header>
    <main class="app-main">
      <div id="loading" class="loading-state">Loading drafts…</div>
      <div id="empty" class="empty-state" hidden>No pending drafts.</div>
      <div id="drafts-list"></div>
    </main>
  </div>

  <!-- ── Toast notification ─────────────────────────── -->
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script>
    // ── Config ────────────────────────────────────────────
    // Firebase function URL — project thecaddiechat-178de, region us-central1.
    const FUNCTION_URL =
      'https://us-central1-thecaddiechat-178de.cloudfunctions.net/publishDraft';

    const GITHUB_REPO = 'awtilly/thecaddiechat';
    const CHRONICLES_API =
      `https://api.github.com/repos/${GITHUB_REPO}/contents/src/content/chronicles`;
    const FIELD_NOTES_API =
      `https://api.github.com/repos/${GITHUB_REPO}/contents/src/content/field-notes`;
    const SESSION_KEY = 'tcc-admin-pw';

    // ── DOM refs ──────────────────────────────────────────
    const gateEl      = document.getElementById('gate');
    const gateForm    = document.getElementById('gate-form');
    const pwInput     = document.getElementById('pw-input');
    const gateErr     = document.getElementById('gate-err');
    const appEl       = document.getElementById('app');
    const appSubtitle = document.getElementById('app-subtitle');
    const lockBtn     = document.getElementById('lock-btn');
    const loadingEl   = document.getElementById('loading');
    const emptyEl     = document.getElementById('empty');
    const draftsEl    = document.getElementById('drafts-list');
    const toastEl     = document.getElementById('toast');

    // ── Auth ──────────────────────────────────────────────
    let password = localStorage.getItem(SESSION_KEY) || '';

    function showGate() {
      localStorage.removeItem(SESSION_KEY);
      password = '';
      gateEl.hidden = false;
      appEl.hidden = true;
      pwInput.value = '';
      gateErr.hidden = true;
      setTimeout(() => pwInput.focus(), 50);
    }

    function showApp(pw) {
      password = pw;
      localStorage.setItem(SESSION_KEY, pw);
      gateEl.hidden = true;
      appEl.hidden = false;
      loadDrafts();
    }

    lockBtn.addEventListener('click', showGate);

    gateForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const pw = pwInput.value.trim();
      if (!pw) return;
      showApp(pw);
    });

    // ── Frontmatter parser ────────────────────────────────
    function parseFrontmatter(raw) {
      const fmMatch = raw.match(/^---\r?\n([\s\S]*?)\r?\n---/);
      if (!fmMatch) return null;

      const fmBlock = fmMatch[1];
      const body = raw.slice(fmMatch[0].length).trim();

      function getField(key) {
        const re = new RegExp(`^${key}:\\s*(.+?)\\s*$`, 'm');
        const m = fmBlock.match(re);
        if (!m) return null;
        let val = m[1].trim();
        if (
          (val.startsWith('"') && val.endsWith('"')) ||
          (val.startsWith("'") && val.endsWith("'"))
        ) val = val.slice(1, -1);
        return val;
      }

      if (getField('draft') !== 'true') return null;

      const scMatch = fmBlock.match(/^sourcesConsidered:\s*\n((?:[ \t]+-[ \t]+.+\n?)+)/m);
      const sourcesConsidered = scMatch
        ? (scMatch[1].match(/[ \t]+-[ \t]+(.+)/g) || []).map(
            (l) => l.replace(/^[ \t]+-[ \t]+/, '').trim()
          )
        : [];

      // Strip markdown/MDX syntax to produce a clean plain-text excerpt
      const preview = body
        .replace(/^#+\s+/gm, '')                          // headings
        .replace(/^>\s*/gm, '')                            // blockquote markers
        .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')         // images → alt text
        .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')          // links → link text
        .replace(/\*\*([^*]+)\*\*/g, '$1')                // bold → text
        .replace(/\*([^*]+)\*/g, '$1')                    // italic → text
        .replace(/`([^`]+)`/g, '$1')                      // inline code → text
        .replace(/<[^>]+>([^<]*)<\/[^>]+>/g, '$1')        // HTML tags with inner text
        .replace(/<[^>]+>/g, '')                           // remaining HTML tags
        .replace(/\n{2,}/g, ' ')                           // collapse blank lines
        .replace(/\n/g, ' ')                               // remaining newlines → spaces
        .trim()
        .slice(0, 300);

      return {
        title: getField('title') || '(untitled)',
        description: getField('description') || '',
        date: getField('date') || '',
        sourceUrl: getField('sourceUrl') || null,
        sourcesConsidered,
        bodyPreview: preview,
      };
    }

    // ── Load drafts from GitHub API ───────────────────────
    async function loadDrafts() {
      loadingEl.hidden = false;
      emptyEl.hidden = true;
      draftsEl.innerHTML = '';
      appSubtitle.textContent = '';

      try {
        const [chronRes, fnRes] = await Promise.all([
          fetch(CHRONICLES_API, { headers: { Accept: 'application/vnd.github+json' } }),
          fetch(FIELD_NOTES_API, { headers: { Accept: 'application/vnd.github+json' } }),
        ]);
        if (!chronRes.ok) throw new Error(`GitHub API ${chronRes.status} (chronicles)`);

        const chronFiles = await chronRes.json();
        const fnFiles = fnRes.ok ? await fnRes.json() : [];

        const taggedFiles = [
          ...chronFiles
            .filter((f) => f.type === 'file' && f.name.endsWith('.mdx'))
            .map((f) => ({ ...f, collection: 'chronicles' })),
          ...fnFiles
            .filter((f) => f.type === 'file' && f.name.endsWith('.mdx'))
            .map((f) => ({ ...f, collection: 'field-notes' })),
        ];

        if (taggedFiles.length === 0) {
          loadingEl.hidden = true;
          emptyEl.hidden = false;
          return;
        }

        const contents = await Promise.all(
          taggedFiles.map((f) =>
            fetch(f.url, { headers: { Accept: 'application/vnd.github+json' } })
              .then((r) => r.json())
              .then((data) => ({ name: f.name, collection: f.collection, data }))
          )
        );

        const drafts = [];
        for (const { name, collection, data } of contents) {
          const raw = atob(data.content.replace(/\s/g, ''));
          const slug = name.replace(/\.mdx$/, '');
          const parsed = parseFrontmatter(raw);
          if (parsed) drafts.push({ slug, collection, ...parsed });
        }

        drafts.sort((a, b) => (b.date > a.date ? 1 : -1));
        loadingEl.hidden = true;

        if (drafts.length === 0) {
          emptyEl.hidden = false;
          appSubtitle.textContent = 'No pending drafts.';
          return;
        }

        updateSubtitle(drafts.length);
        draftsEl.innerHTML = drafts.map(renderCard).join('');
        attachCardListeners();
      } catch (err) {
        loadingEl.hidden = true;
        draftsEl.innerHTML = `<p class="error-msg">Failed to load drafts: ${escHtml(err.message)}</p>`;
      }
    }

    function updateSubtitle(n) {
      appSubtitle.textContent = n === 0
        ? 'No pending drafts.'
        : `${n} draft${n === 1 ? '' : 's'} pending — site rebuilds ~1–2 min after action.`;
    }

    // ── Render card ───────────────────────────────────────
    function renderCard(draft) {
      const formattedDate = draft.date
        ? new Date(draft.date + 'T12:00:00Z').toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric',
          })
        : '';

      const sourceHtml = draft.sourceUrl
        ? `<p class="card-source">Source: <a href="${escHtml(draft.sourceUrl)}" target="_blank" rel="noopener noreferrer">${escHtml(draft.sourceUrl)}</a></p>`
        : '';

      const preview = draft.bodyPreview + (draft.bodyPreview.length >= 300 ? '…' : '');
      const slug = escHtml(draft.slug);
      const collection = escHtml(draft.collection || 'chronicles');
      const collectionLabel = draft.collection === 'field-notes' ? 'Field Notes' : 'Chronicles';

      return `
<article class="draft-card" id="card-${slug}">
  <header class="card-header">
    <span class="draft-badge">Draft</span>
    <h2 class="card-title">${escHtml(draft.title)}</h2>
    <span class="card-meta">${escHtml(formattedDate)} &middot; <code>${slug}</code> &middot; ${collectionLabel}</span>
  </header>
  <div class="card-body">
    <p class="card-desc">${escHtml(draft.description)}</p>
    <pre class="card-preview">${escHtml(preview)}</pre>
    ${sourceHtml}
  </div>
  <footer class="card-actions">
    <a href="/admin/preview/?slug=${slug}&collection=${collection}" target="_blank" class="admin-btn btn-preview">Preview →</a>
    <button class="admin-btn btn-publish" data-slug="${slug}" data-collection="${collection}" data-action="publish">Publish</button>
    <button class="admin-btn btn-discard" data-slug="${slug}" data-collection="${collection}" data-action="discard">Discard</button>
    <span class="card-status" id="status-${slug}"></span>
  </footer>
</article>`;
    }

    function escHtml(str) {
      if (str == null) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // ── Card action handlers ──────────────────────────────
    function attachCardListeners() {
      draftsEl.querySelectorAll('.btn-publish, .btn-discard').forEach((btn) => {
        btn.addEventListener('click', () => {
          const slug = btn.dataset.slug;
          const action = btn.dataset.action;
          const collection = btn.dataset.collection || 'chronicles';
          if (action === 'discard') {
            if (!confirm(`Discard "${slug}"?\n\nThis permanently deletes the draft.`)) return;
          }
          handleAction(slug, action, collection);
        });
      });
    }

    async function handleAction(slug, action, collection = 'chronicles') {
      const card = document.getElementById(`card-${slug}`);
      const statusEl = document.getElementById(`status-${slug}`);
      const buttons = card?.querySelectorAll('.btn-publish, .btn-discard');

      if (statusEl) {
        statusEl.textContent = action === 'publish' ? 'Publishing…' : 'Discarding…';
        statusEl.className = 'card-status';
      }
      buttons?.forEach((b) => { b.disabled = true; });

      try {
        const res = await fetch(FUNCTION_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password, action, slug, collection }),
        });

        let data;
        try { data = await res.json(); } catch { data = {}; }

        if (data.ok) {
          showToast(data.message || 'Done', 'success');
          setTimeout(() => {
            card?.remove();
            const remaining = draftsEl.querySelectorAll('.draft-card').length;
            updateSubtitle(remaining);
            if (remaining === 0) emptyEl.hidden = false;
          }, 600);
        } else {
          const msg = data.error || `HTTP ${res.status}`;
          if (statusEl) {
            statusEl.textContent = `Error: ${msg}`;
            statusEl.className = 'card-status error';
          }
          showToast(msg, 'error');
          buttons?.forEach((b) => { b.disabled = false; });
        }
      } catch (err) {
        if (statusEl) {
          statusEl.textContent = 'Network error — check connection';
          statusEl.className = 'card-status error';
        }
        buttons?.forEach((b) => { b.disabled = false; });
      }
    }

    // ── Toast ─────────────────────────────────────────────
    let toastTimer;
    function showToast(msg, type = 'success') {
      toastEl.textContent = msg;
      toastEl.className = `toast toast--visible${type === 'error' ? ' toast--error' : ''}`;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { toastEl.className = 'toast'; }, 4500);
    }

    // ── Init ──────────────────────────────────────────────
    // If a password is already in localStorage, skip the gate.
    // localStorage persists across tabs so Preview links (target=_blank) work.
    if (password) {
      gateEl.hidden = true;
      appEl.hidden = false;
      loadDrafts();
    }
  </script>
</body>
</html>
