---
import PageLayout from '../../layouts/PageLayout.astro';
import PostListing from '../../components/PostListing.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { getCollection } from 'astro:content';

const allFieldNotes = await getCollection('fieldNotes');
// Drafts are never shown in the main listing
const fieldNotes = allFieldNotes
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<PageLayout
  title="Field Notes | The Caddie Chat"
  description="Technical insights from the dirt, drainage, and design of golf course construction."
  pageTitle="Field Notes"
  pageSubtitle="Technical insights from the dirt, drainage, and design of golf course construction."
  sectionLabel="Construction & Design"
>
  <PostListing posts={fieldNotes} basePath="/field-notes/">
    <div class="empty-state" slot="empty">
      <span class="section-label">Coming Soon</span>
      <h2>The first notes are being written.</h2>
      <p>
        Field Notes is where the construction side of the story gets told:
        what actually happens in the dirt when a golf course gets built or
        restored. Drainage that works with the land instead of against it,
        shaping that turns an architect's sketch into a green you can putt
        on, and the decisions made in muddy boots that golfers never see.
        The first entries are in progress and will land here as projects
        move forward.
      </p>
    </div>
  </PostListing>

  <CtaBanner
    heading='More notes <em>coming.</em>'
    description="New field notes drop as projects progress. Follow along for construction insights from the course."
    buttonText="Follow on Instagram"
    buttonHref="https://instagram.com/thecaddiechat"
    buttonExternal={true}
  />
</PageLayout>

<style>
  .empty-state {
    max-width: 640px;
    padding: var(--space-md) 0;
  }
  .empty-state h2 {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--leading-snug);
    margin-bottom: var(--space-sm);
  }
  .empty-state p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--leading-relaxed);
  }
</style>
