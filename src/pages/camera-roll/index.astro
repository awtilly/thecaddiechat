---
import PageLayout from '../../layouts/PageLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import FilterBar from '../../components/camera-roll/FilterBar.astro';
import RollSection from '../../components/camera-roll/RollSection.astro';
import FrameViewer from '../../components/camera-roll/FrameViewer.astro';
import { loadCameraRoll } from '../../lib/camera-roll';
import '../../styles/camera-roll.css';

// Golf up top, travel below. What is on the page and in what order is
// src/data/camera-roll.json; the scans are in src/assets/images/camera-roll/.
const { sections, frameCount, rollCount } = await loadCameraRoll();

const NUMBER_WORDS = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const rollsWord = NUMBER_WORDS[rollCount] ?? String(rollCount);
const PART_LABELS = ['Part one', 'Part two', 'Part three'];
---
<PageLayout
  title="Camera Roll | The Caddie Chat"
  description={`${rollsWord} rolls of 35mm film: golf courses, a tournament week and a course build up top, then the travel between them.`}
>
  <div class="cr">
    <header class="cr-wrap cr-head">
      <span class="section-label">Photography</span>
      <h1>Camera <em>Roll</em></h1>
      <p class="sub">{rollsWord} rolls of 35mm. Golf up top: courses, a tournament week, a build. Then the travel, the road between them.</p>
      <p class="stat cr-mono">{rollCount} rolls &middot; {frameCount} frames &middot; 35mm</p>
    </header>

    <FilterBar sections={sections} total={frameCount} />

    <div class="cr-wrap cr-end">
      <section class="cr-index" id="rolls" aria-label="Rolls">
        {sections.map((section) => (
          <div class="grp">
            <h2><a href={`#${section.id}`}>{section.title}</a> <span>{section.count} frames &middot; {section.rolls.length} rolls</span></h2>
            <div class="rows">
              {section.rolls.map((roll) => (
                <a class="cr-row" href={`#${roll.anchor}`}>
                  <span class="no">No. {roll.no}</span>
                  <img src={roll.cover.thumb.src} width="84" height="56" alt="" loading="lazy" decoding="async" />
                  <span class="what">
                    <strong>{roll.title}</strong>
                    {roll.chapters.length > 1 && <small>{roll.chapters.map((c) => c.title).join(' · ')}</small>}
                  </span>
                  <span class="n">{roll.frames.length}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>

      <p class="cr-result" aria-live="polite"></p>

      {sections.map((section, i) => (
        <RollSection section={section} label={PART_LABELS[i] ?? `Part ${i + 1}`} />
      ))}
    </div>

    <a class="cr-rollsbtn cr-mono" href="#rolls">Rolls <span aria-hidden="true">&uarr;</span></a>
    <FrameViewer />
  </div>

  <CtaBanner
    heading='See more on <em>Instagram.</em>'
    description="Daily shots, behind-the-scenes, and work in progress. The feed is always alive."
    buttonText="@thecaddiechat"
    buttonHref="https://instagram.com/thecaddiechat"
    buttonExternal={true}
  />
</PageLayout>
