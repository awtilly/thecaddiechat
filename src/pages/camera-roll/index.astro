---
import PageLayout from '../../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import CtaBanner from '../../components/CtaBanner.astro';
import Lightbox from '../../components/Lightbox.astro';

// Glob import all camera roll images
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/camera-roll/*.jpg',
  { eager: true }
);

// Group by film roll prefix (first 9 digits of filename)
const rollMap = new Map<string, { src: ImageMetadata; filename: string }[]>();
for (const [path, module] of Object.entries(allImages)) {
  const filename = path.split('/').pop()!.replace('.jpg', '');
  const rollId = filename.substring(0, 9);
  if (!rollMap.has(rollId)) rollMap.set(rollId, []);
  rollMap.get(rollId)!.push({ src: module.default, filename });
}

// Sort each roll's images by filename
for (const images of rollMap.values()) {
  images.sort((a, b) => a.filename.localeCompare(b.filename));
}

// Convert to array and sort rolls by their ID
const rolls = [...rollMap.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([id, images], index) => ({
    id,
    label: `Roll ${index + 1}`,
    count: images.length,
    images,
  }));
---
<PageLayout
  title="Camera Roll | The Caddie Chat"
  description="Photography galleries -- film rolls from abroad, tournament moments, and city streets."
  pageTitle='Camera<br><em>Roll</em>'
  pageSubtitle="A visual journal -- film rolls from abroad, tournament moments, and city streets through a caddie's lens."
  sectionLabel="Photography"
>
  <section class="section-pad-lg">
    <div class="container">
      {rolls.map((roll) => (
        <div class="gallery-section" data-scroll-reveal>
          <div class="gallery-section-header">
            <h2>{roll.label}</h2>
            <span>{roll.count} Frames</span>
          </div>
          <div class="roll-grid">
            {roll.images.map((image, i) => (
              <Image
                src={image.src}
                alt={`Film photograph ${i + 1} from ${roll.label}`}
                widths={[400, 800, 1200]}
                sizes="(max-width: 768px) 50vw, (max-width: 1280px) 33vw, 25vw"
                loading="lazy"
                data-lightbox
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <CtaBanner
    heading='See more on <em>Instagram.</em>'
    description="Daily shots, behind-the-scenes, and work in progress -- the feed is always alive."
    buttonText="@thecaddiechat"
    buttonHref="https://instagram.com/thecaddiechat"
    buttonExternal={true}
  />

  <Lightbox />
</PageLayout>

<style>
  .roll-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }
  .roll-grid img {
    width: 100%;
    aspect-ratio: 3/2;
    object-fit: cover;
    cursor: pointer;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .roll-grid img:hover {
    opacity: 0.85;
  }
  @media (max-width: 1280px) {
    .roll-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 768px) {
    .roll-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
