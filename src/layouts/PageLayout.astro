---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  pageTitle?: string;
  pageSubtitle?: string;
  sectionLabel?: string;
}

const { title, description, pageTitle, pageSubtitle, sectionLabel } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <Nav />
  {pageTitle && (
    <header class="page-header">
      <div class="container">
        {sectionLabel && <span class="section-label">{sectionLabel}</span>}
        <h1 set:html={pageTitle} />
        {pageSubtitle && <p>{pageSubtitle}</p>}
      </div>
    </header>
    <div class="divider"></div>
  )}
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: calc(var(--nav-height) + var(--space-xl)) 0 var(--space-lg);
  }
  .page-header :global(h1) {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 500;
    line-height: 1.05;
    margin-bottom: var(--space-sm);
    animation: fadeInUp 1s ease;
  }
  .page-header :global(h1 em) {
    font-style: italic;
    color: var(--color-accent);
  }
  .page-header p {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    max-width: 600px;
    line-height: 1.8;
  }
</style>
