---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ArticleNav from '../components/ArticleNav.astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  heroImage?: ImageMetadata;
  meta?: string;
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

const { title, description, date, heroImage, meta, prev, next } = Astro.props;
---
<BaseLayout title={`${title} | The Caddie Chat`} description={description}>
  <Nav />
  <div class="container">
    <header class="article-header">
      <div class="breadcrumb">
        <a href="/chronicles/">Chronicles</a> &nbsp;/&nbsp; {title.length > 50 ? title.substring(0, 47) + '...' : title}
      </div>
      <h1>{title}</h1>
      <div class="article-meta">
        {meta && <span>{meta}</span>}
        {meta && ' \u00B7 '}
        The Caddie Chat
      </div>
    </header>
  </div>
  <div class="divider"></div>
  {heroImage && (
    <div class="article-hero-image">
      <Image src={heroImage} alt={title} layout="constrained" priority />
    </div>
  )}
  <section class="section-pad">
    <div class="article-body">
      <slot />
    </div>
    <ArticleNav prev={prev} next={next} basePath="/chronicles/" />
  </section>
  <Footer />
</BaseLayout>

<style>
  .article-header {
    padding: calc(var(--nav-height) + var(--space-xl)) 0 var(--space-md);
    max-width: 800px;
    margin: 0 auto;
  }
  .breadcrumb {
    font-size: var(--font-size-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }
  .breadcrumb a {
    color: var(--color-accent);
    transition: var(--transition-color);
  }
  .breadcrumb a:hover {
    color: var(--color-text-primary);
  }
  .article-header h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-sm);
  }
  .article-meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .article-hero-image {
    max-width: 900px;
    margin: 0 auto var(--space-lg);
    overflow: hidden;
  }
  .article-hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>

<style is:global>
  .article-body {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding-bottom: var(--space-2xl);
  }
  .article-body p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--leading-loose);
    margin-bottom: 1.5rem;
  }
  .article-body > p:first-child::first-letter {
    font-family: var(--font-display);
    font-size: var(--font-size-4xl);
    float: left;
    line-height: 0.8;
    margin-right: 0.08em;
    margin-top: 0.05em;
    color: var(--color-accent);
    font-weight: 700;
  }
  .article-body h2 {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    color: var(--color-text-primary);
  }
  .article-body h3 {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: 500;
    line-height: var(--leading-snug);
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
    color: var(--color-text-primary);
  }
  .article-body blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-md);
    margin: var(--space-md) 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--font-size-md);
    color: var(--color-text-primary);
    line-height: var(--leading-relaxed);
    opacity: 0;
    transform: translateX(-30px);
  }
  @media (prefers-reduced-motion: reduce) {
    .article-body blockquote {
      opacity: 1;
      transform: none;
    }
  }
  .article-body .pull-quote {
    text-align: center;
    padding: var(--space-lg) var(--space-md);
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-style: italic;
    color: var(--color-accent);
    line-height: var(--leading-snug);
    max-width: none;
    margin: var(--space-lg) auto;
    border-top: 1.5px solid var(--color-border-strong);
    border-bottom: 1.5px solid var(--color-border-strong);
  }
  .article-inline-image {
    margin: var(--space-md) 0;
  }
  .article-inline-image img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--color-border);
  }
  .article-inline-image figcaption {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-xs);
    font-style: italic;
    text-align: center;
  }
</style>
