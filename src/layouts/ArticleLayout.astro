---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ArticleNav from '../components/ArticleNav.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image, getImage } from 'astro:assets';

interface Source {
  title: string;
  url: string;
  publisher?: string;
  publishedAt?: string;
}

interface Props {
  title: string;
  description?: string;
  date?: Date;
  heroImage?: ImageMetadata;
  meta?: string;
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
  sources?: Source[];
  collectionLabel?: string;
  collectionPath?: string;
}

const { title, description, date, heroImage, meta, prev, next, sources, collectionLabel = 'Chronicles', collectionPath = '/chronicles/' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLdImage = heroImage
  ? new URL((await getImage({ src: heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site).href
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title,
  ...(description && { "description": description }),
  ...(date && { "datePublished": date.toISOString(), "dateModified": date.toISOString() }),
  ...(jsonLdImage && { "image": [jsonLdImage] }),
  "url": canonical,
  "mainEntityOfPage": canonical,
  "author": {
    "@type": "Person",
    "name": "Joe Stoehner",
    "url": "https://thecaddiechat.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Caddie Chat",
    "logo": {
      "@type": "ImageObject",
      "url": "https://thecaddiechat.com/favicon.svg"
    }
  },
  ...(sources && sources.length > 0 && {
    "citation": sources.map((s) => ({
      "@type": "CreativeWork",
      "name": s.title,
      "url": s.url,
      ...(s.publisher && { "publisher": { "@type": "Organization", "name": s.publisher } }),
      ...(s.publishedAt && { "datePublished": s.publishedAt }),
    }))
  })
};
---
<BaseLayout title={`${title} | The Caddie Chat`} description={description} ogImage={heroImage} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Nav />
  <div class="container">
    <header class="article-header">
      <div class="breadcrumb">
        <a href={collectionPath}>{collectionLabel}</a> &nbsp;/&nbsp; {title.length > 50 ? title.substring(0, 47) + '...' : title}
      </div>
      <h1>{title}</h1>
      <div class="article-meta">
        {meta && <span>{meta}</span>}
        {meta && ' \u00B7 '}
        The Caddie Chat
      </div>
    </header>
  </div>
  <div class="divider"></div>
  {heroImage && (
    <div class="article-hero-image">
      <Image src={heroImage} alt={title} layout="constrained" priority />
    </div>
  )}
  <section class="section-pad">
    <div class="article-body">
      <slot />
    </div>
    {sources && sources.length > 0 && (
      <aside class="sources-section">
        <h2 class="sources-heading">Sources</h2>
        <ul class="sources-list">
          {sources.map((s) => (
            <li class="sources-item">
              <a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a>
              {(s.publisher || s.publishedAt) && (
                <span class="sources-meta">
                  {s.publisher}{s.publisher && s.publishedAt && ', '}{s.publishedAt}
                </span>
              )}
            </li>
          ))}
        </ul>
      </aside>
    )}
    <ArticleNav prev={prev} next={next} basePath={collectionPath} />
  </section>
  <Lightbox />
  <Footer />
</BaseLayout>

<style>
  .article-header {
    padding: calc(var(--nav-height) + var(--space-xl)) 0 var(--space-md);
    max-width: 800px;
    margin: 0 auto;
  }
  .breadcrumb {
    font-size: var(--font-size-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }
  .breadcrumb a {
    color: var(--color-accent);
    transition: var(--transition-color);
  }
  .breadcrumb a:hover {
    color: var(--color-text-primary);
  }
  .article-header h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-sm);
  }
  .article-meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .article-hero-image {
    max-width: 900px;
    margin: 0 auto var(--space-lg);
    overflow: hidden;
  }
  .article-hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .sources-section {
    max-width: var(--measure-wide);
    margin: 0 auto var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .sources-heading {
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }
  .sources-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .sources-item {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .sources-item a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(45, 90, 63, 0.3);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .sources-item a:hover {
    color: var(--color-accent-light);
  }
  .sources-meta {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: 2px;
  }
</style>

<style is:global>
  .article-body {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding-bottom: var(--space-2xl);
  }
  .article-body p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--leading-loose);
    margin-bottom: 1.5rem;
  }
  .article-body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(45, 90, 63, 0.3);
    transition: color var(--duration-fast) var(--ease-out), text-decoration-color var(--duration-fast) var(--ease-out);
  }
  .article-body a:hover {
    color: var(--color-accent-light);
    text-decoration-color: var(--color-accent-light);
  }
  .article-body > p:first-child::first-letter {
    font-family: var(--font-display);
    font-size: var(--font-size-4xl);
    float: left;
    line-height: 0.8;
    margin-right: 0.08em;
    margin-top: 0.05em;
    color: var(--color-accent);
    font-weight: 700;
  }
  .article-body h2 {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    color: var(--color-text-primary);
  }
  .article-body h3 {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: 500;
    line-height: var(--leading-snug);
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
    color: var(--color-text-primary);
  }
  .article-body blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-md);
    margin: var(--space-md) 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--font-size-md);
    color: var(--color-text-primary);
    line-height: var(--leading-relaxed);
  }
  .article-body .pull-quote {
    text-align: center;
    padding: var(--space-lg) var(--space-md);
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-style: italic;
    color: var(--color-accent);
    line-height: var(--leading-snug);
    max-width: none;
    margin: var(--space-lg) auto;
    border-top: 1.5px solid var(--color-border-strong);
    border-bottom: 1.5px solid var(--color-border-strong);
  }
  .article-inline-image {
    margin: var(--space-md) 0;
  }
  .article-inline-image img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--color-border);
  }
  .article-inline-image figcaption {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-xs);
    font-style: italic;
    text-align: center;
  }
</style>
