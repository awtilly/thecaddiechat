---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ArticleNav from '../components/ArticleNav.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  architect?: string;
  year?: number;
  location?: string;
  heroImage?: ImageMetadata;
  courseNumber?: string;
  style?: string;
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

const { title, description, architect, year, location, heroImage, courseNumber, style, prev, next } = Astro.props;

// Split title for styling (e.g. "Friar's Head" -> "Friar's" + "Head")
const titleParts = title.split(' ');
const lastWord = titleParts.pop();
const firstPart = titleParts.join(' ');
---
<BaseLayout title={`${title} | The Caddie Chat`} description={description}>
  <Nav />

  <section class="course-hero">
    <div class="container">
      <span class="section-label">
        <a href="/courses/golden-age-golf/">Golden Age Golf</a> / {courseNumber}
      </span>
      <div class="course-number">{courseNumber}</div>
      <h1>
        {firstPart && <Fragment>{firstPart}<br /></Fragment>}
        <em>{lastWord}</em>
      </h1>
      <div class="course-meta">
        {architect && (
          <div class="course-meta-item">
            <span class="course-meta-label">Architects</span>
            <span class="course-meta-value">{architect}</span>
          </div>
        )}
        {year && (
          <div class="course-meta-item">
            <span class="course-meta-label">Opened</span>
            <span class="course-meta-value">{year}</span>
          </div>
        )}
        {location && (
          <div class="course-meta-item">
            <span class="course-meta-label">Location</span>
            <span class="course-meta-value">{location}</span>
          </div>
        )}
        {style && (
          <div class="course-meta-item">
            <span class="course-meta-label">Style</span>
            <span class="course-meta-value">{style}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  {heroImage && (
    <div class="course-hero-image">
      <Image src={heroImage} alt={title} layout="full-width" priority />
    </div>
  )}

  <section class="section-pad-lg">
    <div class="container">
      <article class="course-body">
        <slot />
      </article>
    </div>
  </section>

  <div class="divider"></div>

  <section>
    <div class="container">
      <ArticleNav prev={prev} next={next} basePath="/courses/" />
    </div>
  </section>

  <Lightbox />
  <Footer />
</BaseLayout>

<style>
  .course-hero {
    padding: calc(var(--nav-height) + var(--space-xl)) 0 var(--space-lg);
  }
  .course-hero :global(.section-label a) {
    color: inherit;
    transition: var(--transition-color);
  }
  .course-hero :global(.section-label a:hover) {
    color: var(--color-text-primary);
  }
  .course-number {
    font-family: var(--font-display);
    font-size: 8rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-text-muted);
    line-height: 1;
    opacity: 0.3;
  }
  .course-hero h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    margin-top: -1rem;
  }
  .course-hero h1 em {
    font-style: italic;
    color: var(--color-accent);
  }
  .course-meta {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .course-meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .course-meta-label {
    font-size: var(--font-size-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .course-meta-value {
    font-family: var(--font-display);
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
  }
  .course-hero-image {
    width: 100%;
    overflow: hidden;
    position: relative;
  }
  .course-hero-image img {
    width: 100%;
    aspect-ratio: 21 / 9;
    max-height: 65vh;
    min-height: 280px;
    object-fit: cover;
    display: block;
  }
  .course-hero-image::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 25%;
    background: linear-gradient(to top, var(--color-bg, #f5f2eb), transparent);
    pointer-events: none;
  }
  @media (max-width: 768px) {
    .course-number { font-size: 5rem; }
    .course-hero-image img { aspect-ratio: 16 / 9; max-height: 50vh; min-height: 220px; }
  }
  @media (max-width: 480px) {
    .course-meta { gap: var(--space-sm); }
    .course-meta-item { min-width: 45%; }
    .course-hero-image img { aspect-ratio: 4 / 3; max-height: 45vh; }
  }
</style>

<style is:global>
  .course-body {
    max-width: 720px;
    margin: 0 auto;
  }
  .course-body p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--leading-loose);
    margin-bottom: 1.5rem;
  }
  .course-body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(45, 90, 63, 0.3);
    transition: color var(--duration-fast) var(--ease-out), text-decoration-color var(--duration-fast) var(--ease-out);
  }
  .course-body a:hover {
    color: var(--color-accent-light);
    text-decoration-color: var(--color-accent-light);
  }
  .course-body > p:first-child::first-letter {
    font-family: var(--font-display);
    font-size: var(--font-size-4xl);
    float: left;
    line-height: 0.8;
    margin-right: 0.08em;
    margin-top: 0.05em;
    color: var(--color-accent);
    font-weight: 700;
  }
  .course-body h2 {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: 500;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    margin: 2.5rem 0 1rem;
  }
  .course-body .pull-quote {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-style: italic;
    color: var(--color-accent);
    line-height: var(--leading-snug);
    padding: var(--space-md) 0;
    margin: var(--space-md) 0;
    border-top: 1.5px solid var(--color-border-strong);
    border-bottom: 1.5px solid var(--color-border-strong);
  }
  .course-body blockquote {
    opacity: 0;
    transform: translateX(-30px);
  }
  @media (prefers-reduced-motion: reduce) {
    .course-body blockquote {
      opacity: 1;
      transform: none;
    }
  }
</style>
