---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
import '../styles/global.css';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/dm-sans';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <slot name="head" />
  <ClientRouter />
</head>
<body>
  <slot />
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';
    import 'lenis/dist/lenis.css';

    gsap.registerPlugin(ScrollTrigger);

    let lenis: Lenis | null = null;
    let ctx: gsap.Context | null = null;

    function initHeroAnimations() {
      const hero = document.querySelector('.hero');
      if (!hero) return;

      // Entrance timeline
      const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });

      tl.fromTo('.hero-kicker', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, 0.3)
        .fromTo('.hero-line', { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 0.9, stagger: 0.2 }, 0.5)
        .fromTo('.hero-sub', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, 1.2)
        .fromTo('.hero-cta', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, 1.4)
        .fromTo('.hero-meta', { opacity: 0 }, { opacity: 1, duration: 0.6 }, 1.6)
        .fromTo('.hero-scroll', { opacity: 0 }, { opacity: 1, duration: 0.6 }, 2.0);

      // Parallax: background moves slower than scroll
      gsap.to('.hero-bg img', {
        yPercent: 20,
        scale: 1.1,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });

      // Content fades out as user scrolls past hero
      gsap.to('.hero-content', {
        opacity: 0,
        y: 80,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top top',
          end: '60% top',
          scrub: true,
        },
      });

      // Scroll indicator fades out quickly
      gsap.to('.hero-scroll', {
        opacity: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top top',
          end: '20% top',
          scrub: true,
        },
      });
    }

    function initStorytellingAnimations() {
      // Full-bleed images: scale up from slightly smaller for cinematic reveal
      gsap.utils.toArray('.full-bleed-image').forEach((el) => {
        const element = el as Element;
        gsap.from(element, {
          scale: 0.95,
          duration: 1,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: element,
            start: 'top 80%',
            toggleActions: 'play none none none',
          },
        });
      });

      // Pull quotes: slide in from left with editorial flair
      gsap.utils.toArray('.article-body blockquote, .course-body blockquote').forEach((el) => {
        const element = el as Element;
        gsap.from(element, {
          x: -30,
          opacity: 0,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: element,
            start: 'top 85%',
            toggleActions: 'play none none none',
          },
        });
      });
    }

    function init() {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Smooth scroll (skip for reduced motion)
      if (!prefersReduced) {
        lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time: number) => { lenis?.raf(time * 1000); });
        gsap.ticker.lagSmoothing(0);
      }

      // GSAP animation context for cleanup
      ctx = gsap.context(() => {
        if (prefersReduced) return;

        // Global scroll reveals -- batch all [data-scroll-reveal] elements
        ScrollTrigger.batch('[data-scroll-reveal]', {
          onEnter: (batch: Element[]) => gsap.to(batch, {
            opacity: 1,
            y: 0,
            stagger: 0.1,
            duration: 0.8,
            ease: 'power2.out',
            overwrite: true,
          }),
          start: 'top 85%',
          once: true,
        });

        // Page-specific animations
        const path = window.location.pathname;

        // Homepage hero
        if (path === '/') {
          initHeroAnimations();
        }

        // Article pages (chronicles and courses)
        if (path.match(/^\/(chronicles|courses)\/[^/]+\/$/)) {
          initStorytellingAnimations();
        }
      });
    }

    function cleanup() {
      ctx?.revert();
      ctx = null;
      lenis?.destroy();
      lenis = null;
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', cleanup);
  </script>
</body>
</html>
