---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import defaultOgSrc from '../assets/images/courses/friars-head/hero-clubhouse-bluff.jpg';

interface Props {
  title: string;
  description?: string;
  ogImage?: ImageMetadata;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, ogImage, ogType = 'website', noindex = false } = Astro.props;
import '../styles/global.css';
// Latin-only @font-face (hand-rolled below): the fontsource index.css files
// also ship latin-ext/cyrillic/vietnamese variants (10 woff2 in dist for the
// 3 faces actually used). No latin-ext glyphs appear anywhere in the content.
// DM Sans italic was never loaded (browser synthesizes it) -- unchanged.
import dmSansUrl from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import playfairUrl from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import playfairItalicUrl from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-italic.woff2?url';

const fontFaceCss = `
@font-face{font-family:'Playfair Display Variable';font-style:normal;font-display:swap;font-weight:400 900;src:url(${playfairUrl}) format('woff2-variations');}
@font-face{font-family:'Playfair Display Variable';font-style:italic;font-display:swap;font-weight:400 900;src:url(${playfairItalicUrl}) format('woff2-variations');}
@font-face{font-family:'DM Sans Variable';font-style:normal;font-display:swap;font-weight:100 1000;src:url(${dmSansUrl}) format('woff2-variations');}
`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogProcessed = await getImage({
  src: ogImage ?? defaultOgSrc,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});
const ogImageUrl = new URL(ogProcessed.src, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script is:inline>document.documentElement.classList.add('js');</script>
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content="#2d5a3f">
  <meta property="og:title" content={title}>
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical}>
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="The Caddie Chat">
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImageUrl}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" as="font" type="font/woff2" href={playfairUrl} crossorigin>
  <link rel="preload" as="font" type="font/woff2" href={playfairItalicUrl} crossorigin>
  <link rel="preload" as="font" type="font/woff2" href={dmSansUrl} crossorigin>
  <style set:html={fontFaceCss}></style>
  <slot name="head" />
  <ClientRouter />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <slot />
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';
    import 'lenis/dist/lenis.css';

    gsap.registerPlugin(ScrollTrigger);

    let lenis: Lenis | null = null;
    let ctx: gsap.Context | null = null;
    let tickerCb: ((time: number) => void) | null = null;

    function initHeroAnimations() {
      const hero = document.querySelector('.hero');
      if (!hero) return;

      // Entrance timeline
      const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });

      tl.fromTo('.hero-kicker', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, 0.3)
        .fromTo('.hero-line', { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 0.9, stagger: 0.2 }, 0.5)
        .fromTo('.hero-sub', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, 1.2)
        .fromTo('.hero-cta', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, 1.4)
        .fromTo('.hero-meta', { opacity: 0 }, { opacity: 1, duration: 0.6 }, 1.6)
        .fromTo('.hero-scroll', { opacity: 0 }, { opacity: 1, duration: 0.6 }, 2.0);

      // Parallax: background moves slower than scroll
      gsap.to('.hero-bg img', {
        yPercent: 20,
        scale: 1.1,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });

      // Content fades out as user scrolls past hero
      gsap.to('.hero-content', {
        opacity: 0,
        y: 80,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top top',
          end: '60% top',
          scrub: true,
        },
      });

      // Scroll indicator fades out quickly
      gsap.to('.hero-scroll', {
        opacity: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top top',
          end: '20% top',
          scrub: true,
        },
      });
    }

    function initStorytellingAnimations() {
      // Full-bleed images: scale up from slightly smaller for cinematic reveal
      gsap.utils.toArray('.full-bleed-image').forEach((el) => {
        const element = el as Element;
        gsap.from(element, {
          scale: 0.95,
          duration: 1,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: element,
            start: 'top 80%',
            toggleActions: 'play none none none',
          },
        });
      });

      // Pull quotes: slide in from left with editorial flair.
      // fromTo, not from: the end state must be explicit (visible), since the
      // CSS no longer pre-hides blockquotes (no-JS visitors must see them).
      gsap.utils.toArray('.article-body blockquote, .course-body blockquote').forEach((el) => {
        const element = el as Element;
        gsap.fromTo(element,
          { x: -30, opacity: 0 },
          {
            x: 0,
            opacity: 1,
            duration: 0.8,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: element,
              start: 'top 85%',
              toggleActions: 'play none none none',
            },
          }
        );
      });
    }

    function init() {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Smooth scroll (skip for reduced motion)
      if (!prefersReduced) {
        lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        });
        lenis.on('scroll', ScrollTrigger.update);
        tickerCb = (time: number) => { lenis?.raf(time * 1000); };
        gsap.ticker.add(tickerCb);
        gsap.ticker.lagSmoothing(0);
      }

      // GSAP animation context for cleanup
      ctx = gsap.context(() => {
        if (prefersReduced) return;

        // Global scroll reveals -- batch all [data-scroll-reveal] elements
        ScrollTrigger.batch('[data-scroll-reveal]', {
          onEnter: (batch: Element[]) => gsap.to(batch, {
            opacity: 1,
            y: 0,
            stagger: 0.1,
            duration: 0.8,
            ease: 'power2.out',
            overwrite: true,
          }),
          start: 'top 85%',
          once: true,
        });

        // Page-specific animations
        const path = window.location.pathname;

        // Homepage hero
        if (path === '/') {
          initHeroAnimations();
        }

        // Article pages (chronicles and courses)
        if (path.match(/^\/(chronicles|courses|field-notes)\/[^/]+\/$/)) {
          initStorytellingAnimations();
        }
      });
    }

    function cleanup() {
      ctx?.revert();
      ctx = null;
      if (tickerCb) {
        gsap.ticker.remove(tickerCb);
        tickerCb = null;
      }
      lenis?.destroy();
      lenis = null;
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', cleanup);
  </script>
</body>
</html>
