---
interface Props {
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
  basePath: string;
}

const { prev, next, basePath } = Astro.props;
---
{(prev || next) && (
  <nav class="article-nav" aria-label="Article navigation">
    {prev ? (
      <a href={`${basePath}${prev.slug}/`}>&larr; Prev: {prev.title}</a>
    ) : (
      <span></span>
    )}
    {next ? (
      <a href={`${basePath}${next.slug}/`}>{next.title} &rarr;</a>
    ) : (
      <span></span>
    )}
  </nav>
)}

<style>
  .article-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    border-top: 1px solid var(--color-border-strong);
    padding-top: var(--space-md);
    margin-top: var(--space-lg);
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  .article-nav a {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    transition: var(--transition-color);
  }
  .article-nav a:last-child {
    text-align: right;
  }
  .article-nav a:hover {
    color: var(--color-accent);
  }
  /* Phones: prev and next each get their own line instead of sharing one */
  @media (max-width: 768px) {
    .article-nav {
      flex-direction: column;
      gap: 0.5rem;
      padding-bottom: var(--space-lg);
    }
    .article-nav a {
      font-size: 0.85rem;
      line-height: 1.6;
      padding: 0.6rem 0;
    }
    .article-nav span:empty {
      display: none;
    }
  }
</style>
