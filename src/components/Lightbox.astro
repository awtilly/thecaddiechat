---
// Lightbox.astro - Image lightbox for pages with data-lightbox images
// Automatically collects clickable images from the page (course-body or full document)
---
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
  <button class="lightbox-close" aria-label="Close lightbox">&times;</button>
  <button class="lightbox-nav lightbox-prev" aria-label="Previous image">&#8249;</button>
  <img id="lightbox-img" src="" alt="">
  <button class="lightbox-nav lightbox-next" aria-label="Next image">&#8250;</button>
  <div class="lightbox-caption" id="lightbox-caption"></div>
</div>

<style>
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.95);
    align-items: center;
    justify-content: center;
    padding: 2rem;
    cursor: zoom-out;
  }
  :global(.lightbox.active) {
    display: flex;
  }
  .lightbox img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 2px;
  }
  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: rgba(255,255,255,0.7);
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    transition: var(--transition-color);
  }
  .lightbox-close:hover {
    color: #fff;
  }
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(255,255,255,0.6);
    font-size: 2.5rem;
    cursor: pointer;
    padding: 1rem;
    transition: var(--transition-color);
  }
  .lightbox-nav:hover {
    color: #fff;
  }
  .lightbox-prev {
    left: 1rem;
  }
  .lightbox-next {
    right: 1rem;
  }
  .lightbox-caption {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.6);
    font-size: 0.85rem;
    font-style: italic;
    text-align: center;
    max-width: 600px;
  }

  @media (max-width: 768px) {
    .lightbox-nav { font-size: 2rem; padding: 0.5rem; }
    .lightbox img { max-width: 95vw; max-height: 85vh; }
    .lightbox-caption { font-size: 0.75rem; max-width: 90vw; bottom: 1rem; }
  }
  @media (max-width: 480px) {
    .lightbox-prev { left: 0.25rem; }
    .lightbox-next { right: 0.25rem; }
  }
  @media (hover: none) and (pointer: coarse) {
    .lightbox-close { font-size: 2.5rem; top: 1rem; right: 1rem; padding: 0.5rem; }
    .lightbox-nav { font-size: 3rem; }
  }
</style>

<script>
  // Abort the document keydown listener on swap so it doesn't accumulate
  // across soft navigations (element listeners die with the swapped body)
  let pageAbort: AbortController | null = null;

  document.addEventListener('astro:before-swap', () => {
    pageAbort?.abort();
    pageAbort = null;
  });

  document.addEventListener('astro:page-load', () => {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption');
    if (!lightbox || !lightboxImg || !lightboxCaption) return;

    // Collect all clickable images -- prefer course-body scope, fall back to full document
    const scope = document.querySelector('.course-body') || document;

    interface LightboxImage {
      src: string;
      caption: string;
    }

    const clickableImages = scope.querySelectorAll('img[data-lightbox]');
    if (clickableImages.length === 0) return;

    pageAbort = new AbortController();

    // Trigger elements in order; captions resolved lazily on open so
    // currentSrc reflects the browser's actual srcset choice
    const triggers = [...clickableImages] as HTMLImageElement[];

    function imageInfo(imgEl: HTMLImageElement): LightboxImage {
      const figure = imgEl.closest('figure');
      const caption = figure?.querySelector('figcaption')?.textContent || imgEl.alt || '';
      return { src: imgEl.currentSrc || imgEl.src, caption };
    }

    // Also collect from hero image (course pages only)
    if (document.querySelector('.course-body')) {
      const heroImg = document.querySelector('.course-hero-image img') as HTMLImageElement | null;
      if (heroImg) triggers.push(heroImg);
    }

    // Keyboard-operable triggers: one delegated listener pair instead of a
    // click handler per image (209 on /camera-roll/)
    triggers.forEach((imgEl, i) => {
      imgEl.style.cursor = 'pointer';
      imgEl.tabIndex = 0;
      imgEl.setAttribute('role', 'button');
      const caption = imageInfo(imgEl).caption;
      imgEl.setAttribute('aria-label', caption ? `View image: ${caption}` : `View image ${i + 1}`);
    });

    let currentIndex = 0;
    let lastTrigger: HTMLElement | null = null;

    function show(index: number) {
      currentIndex = index;
      const info = imageInfo(triggers[index]);
      lightboxImg.src = info.src;
      lightboxImg.alt = info.caption;
      lightboxCaption.textContent = info.caption;
    }

    function openLightbox(index: number) {
      if (triggers.length === 0) return;
      lastTrigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      show(index);
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
      (lightbox.querySelector('.lightbox-close') as HTMLElement | null)?.focus();
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
      lastTrigger?.focus();
      lastTrigger = null;
    }

    function navigate(dir: number) {
      show((currentIndex + dir + triggers.length) % triggers.length);
    }

    function triggerFromEvent(e: Event): number {
      const img = (e.target as HTMLElement).closest?.('img[data-lightbox], .course-hero-image img');
      return img ? triggers.indexOf(img as HTMLImageElement) : -1;
    }

    document.addEventListener('click', (e) => {
      const i = triggerFromEvent(e);
      if (i >= 0) openLightbox(i);
    }, { signal: pageAbort!.signal });

    // Lightbox controls
    lightbox.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('lightbox-nav') ||
          target.classList.contains('lightbox-prev') ||
          target.classList.contains('lightbox-next')) return;
      closeLightbox();
    });

    const closeBtn = lightbox.querySelector('.lightbox-close');
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeLightbox();
    });

    const prevBtn = lightbox.querySelector('.lightbox-prev');
    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      navigate(-1);
    });

    const nextBtn = lightbox.querySelector('.lightbox-next');
    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      navigate(1);
    });

    document.addEventListener('keydown', (e) => {
      // Enter/Space on a trigger image opens the viewer
      if (!lightbox.classList.contains('active')) {
        if (e.key === 'Enter' || e.key === ' ') {
          const i = triggerFromEvent(e);
          if (i >= 0) {
            e.preventDefault();
            openLightbox(i);
          }
        }
        return;
      }
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') navigate(-1);
      if (e.key === 'ArrowRight') navigate(1);
      // Trap Tab among the dialog's three buttons while open
      if (e.key === 'Tab') {
        const buttons = [...lightbox.querySelectorAll('button')] as HTMLElement[];
        const first = buttons[0];
        const last = buttons[buttons.length - 1];
        const active = document.activeElement as HTMLElement | null;
        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        } else if (!active || !buttons.includes(active)) {
          e.preventDefault();
          first.focus();
        }
      }
    }, { signal: pageAbort!.signal });

    // Expose openLightbox globally for inline onclick handlers
    (window as any).openLightbox = openLightbox;
  }, { once: false });
</script>
