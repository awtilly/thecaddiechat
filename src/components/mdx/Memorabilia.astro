---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  label?: string;
  caption?: string;
}

const { src, alt, label, caption } = Astro.props;
---
<div class="memorabilia">
  {label && <div class="memorabilia-label">{label}</div>}
  <figure>
    <Image src={src} alt={alt} loading="lazy" layout="constrained" data-lightbox />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
</div>

<style>
  .memorabilia {
    max-width: 360px;
    margin: 0 auto;
    padding: var(--space-md) 0;
    text-align: center;
  }
  .memorabilia-label {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  .memorabilia :global(img) {
    max-height: 380px;
    width: auto;
    max-width: 100%;
    display: inline-block;
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    border-radius: 2px;
  }
  .memorabilia :global(img:hover) {
    transform: translateY(-4px);
    opacity: 0.92;
  }
  figcaption {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 1rem;
    font-style: italic;
  }
</style>
