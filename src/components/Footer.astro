---
// Footer.astro - Site footer
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">The Caddie <span>Chat</span></div>
      <ul class="footer-links">
        <li><a href="/chronicles/">Chronicles</a></li>
        <li><a href="/courses/">Courses</a></li>
        <li><a href="/camera-roll/">Camera Roll</a></li>
        <li>
          <a href="https://stoekmedia.com" target="_blank" rel="noopener" class="nav-stoek">
            <span class="stoek">Stoek</span><span class="media">Media.com</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="footer-bottom">
      <span class="footer-copy">&copy; 2025 The Caddie Chat. All Rights Reserved. Created by Joe Stoehner.</span>
      <div class="footer-social">
        <a href="https://instagram.com/thecaddiechat" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <circle cx="12" cy="12" r="5"/>
            <circle cx="17.5" cy="6.5" r="1.5"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1.5px solid var(--color-border-strong);
    padding: var(--space-lg) 0 var(--space-md);
    background: var(--color-bg);
  }
  .footer-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-lg);
  }
  .footer-brand {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .footer-brand span {
    color: var(--color-accent);
  }
  .footer-links {
    display: flex;
    gap: var(--space-md);
    list-style: none;
  }
  .footer-links a {
    position: relative;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    transition: var(--transition-color);
  }
  .footer-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-normal) var(--ease-out);
  }
  .footer-links a:hover {
    color: var(--color-accent);
  }
  .footer-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .footer-links :global(.nav-stoek::after) {
    display: none;
  }
  .footer-links :global(.nav-stoek) {
    text-transform: none;
    letter-spacing: 0;
  }
  .footer-links :global(.nav-stoek .stoek) {
    color: #d45d5d;
  }
  .footer-links :global(.nav-stoek .media) {
    color: var(--color-text-primary);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .footer-copy {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }
  .footer-social a {
    color: var(--color-text-muted);
    transition: var(--transition-color);
  }
  .footer-social a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .footer-grid {
      flex-direction: column;
      gap: var(--space-md);
    }
    .footer-bottom {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
