---
// Nav.astro - Fixed navigation bar with mobile toggle
---
<nav class="nav">
  <div class="container">
    <a href="/" class="nav-logo">The Caddie <span>Chat</span></a>
    <ul class="nav-links">
      <li><a href="/chronicles/">Chronicles</a></li>
      <li><a href="/courses/">Courses</a></li>
      <li><a href="/camera-roll/">Camera Roll</a></li>
      <li>
        <a href="https://stoekmedia.com" target="_blank" rel="noopener" class="nav-stoek">
          <span class="stoek">Stoek</span><span class="media">Media.com</span>
        </a>
      </li>
    </ul>
    <button class="nav-toggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    background: rgba(247, 244, 239, 0.85);
    backdrop-filter: blur(20px);
    transition: all var(--duration-normal) var(--ease-out);
  }
  .nav :global(.container) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }
  :global(.nav.scrolled) {
    background: rgba(247, 244, 239, 0.95);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 20px rgba(0,0,0,0.04);
  }
  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-primary);
  }
  .nav-logo span {
    color: var(--color-accent);
  }
  .nav-links {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    align-items: center;
  }
  .nav-links a {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    transition: var(--transition-color);
    position: relative;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-normal) var(--ease-out);
  }
  .nav-links a:hover {
    color: var(--color-accent);
  }
  .nav-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-links :global(.nav-stoek) {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
  }
  .nav-links :global(.nav-stoek::after) {
    display: none;
  }
  .nav-links :global(.nav-stoek .stoek) {
    color: #d45d5d;
  }
  .nav-links :global(.nav-stoek .media) {
    color: var(--color-text-primary);
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 4px;
    background: none;
    border: none;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--color-text-primary);
    transition: all var(--duration-fast) var(--ease-out);
  }
  :global(.nav-toggle.active) span:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }
  :global(.nav-toggle.active) span:nth-child(2) {
    opacity: 0;
  }
  :global(.nav-toggle.active) span:nth-child(3) {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  /* Nav transparent on hero pages */
  :global(.nav.hero-nav) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  :global(.nav.hero-nav) .nav-logo,
  :global(.nav.hero-nav) .nav-links a {
    color: rgba(255,255,255,0.85);
  }
  :global(.nav.hero-nav) .nav-logo span {
    color: #c9ddb8;
  }
  :global(.nav.hero-nav) .nav-toggle span {
    background: #fff;
  }
  :global(.nav.hero-nav) .nav-links :global(.nav-stoek .stoek) {
    color: #e8a0a0;
  }
  :global(.nav.hero-nav) .nav-links :global(.nav-stoek .media) {
    color: rgba(255,255,255,0.85);
  }
  :global(.nav.hero-nav) .nav-links a:hover {
    color: #fff;
  }
  :global(.nav.hero-nav) .nav-links a::after {
    background: #fff;
  }

  /* Mobile nav overlay */
  :global(.nav-overlay) {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1090;
    background: rgba(28, 28, 28, 0.5);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }
  :global(.nav-overlay.visible) {
    display: block;
    opacity: 1;
  }

  @media (max-width: 768px) {
    .nav {
      background: rgba(247, 244, 239, 0.98);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .nav-links {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 280px;
      height: 100vh;
      height: 100dvh;
      background: var(--color-bg-elevated);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: var(--space-md);
      transform: translateX(100%);
      transition: transform var(--duration-normal) var(--ease-out);
      z-index: 1100;
      box-shadow: -10px 0 40px rgba(0,0,0,0.15);
      overflow-y: auto;
    }
    :global(.nav-links.open) {
      transform: translateX(0);
    }
    .nav-links li {
      width: 100%;
      text-align: center;
    }
    .nav-links a {
      display: block;
      padding: 0.85rem var(--space-md);
      font-size: 0.9rem;
      letter-spacing: 0.14em;
    }
    .nav-links :global(.nav-stoek) {
      letter-spacing: 0;
    }
    .nav-toggle {
      display: flex;
      z-index: 1101;
      position: relative;
    }

    /* Keep mobile nav opaque even with hero-nav */
    :global(.nav.hero-nav) .nav-links {
      background: var(--color-bg-elevated);
    }
    :global(.nav.hero-nav) .nav-links a {
      color: var(--color-text-secondary);
    }
    :global(.nav.hero-nav) .nav-links a:hover {
      color: var(--color-accent);
    }
    :global(.nav.hero-nav) .nav-links :global(.nav-stoek .stoek) {
      color: #d45d5d;
    }
    :global(.nav.hero-nav) .nav-links :global(.nav-stoek .media) {
      color: var(--color-text-primary);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('.nav');
    const hero = document.querySelector('.hero');
    if (nav && hero) {
      nav.classList.add('hero-nav');
      window.addEventListener('scroll', () => {
        const pastHero = window.scrollY > hero.offsetHeight - 100;
        nav.classList.toggle('scrolled', pastHero);
        nav.classList.toggle('hero-nav', !pastHero);
      }, { passive: true });
    } else if (nav) {
      window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 50);
      }, { passive: true });
    }

    const toggle = document.querySelector('.nav-toggle');
    const links = document.querySelector('.nav-links');

    // Create overlay backdrop for mobile nav
    const overlay = document.createElement('div');
    overlay.className = 'nav-overlay';
    if (nav) {
      nav.appendChild(overlay);
    } else {
      document.body.appendChild(overlay);
    }

    function openMenu() {
      toggle?.classList.add('active');
      links?.classList.add('open');
      overlay.classList.add('visible');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      toggle?.classList.remove('active');
      links?.classList.remove('open');
      overlay.classList.remove('visible');
      document.body.style.overflow = '';
    }

    if (toggle && links) {
      toggle.addEventListener('click', () => {
        if (links.classList.contains('open')) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      overlay.addEventListener('click', closeMenu);

      links.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', closeMenu);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && links.classList.contains('open')) {
          closeMenu();
        }
      });
    }

    // Scroll reveals
    const reveals = document.querySelectorAll('.reveal');
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    if (reveals.length && !isMobile) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(el => observer.observe(el));
    }

    // Staggered card transitions
    const cards = document.querySelectorAll('.content-card, .post-card, .collection-card, .course-item');
    cards.forEach((card, i) => { (card as HTMLElement).style.transitionDelay = `${i * 0.08}s`; });
  });
</script>
