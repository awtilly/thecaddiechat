---
// Masthead.astro - Homepage header. Floats over the hero photo: white type, no
// bar and no rule, with a soft dark fade behind it that ends at zero so it has
// no visible edge. It scrolls away with the hero.
//
// Class names deliberately avoid `.nav*`: Nav.astro's script stays loaded after
// a soft navigation and would otherwise adopt this element.
const links = [
  { href: '/chronicles/', label: 'Chronicles' },
  { href: '/courses/', label: 'Courses' },
  { href: '/field-notes/', label: 'Field Notes' },
  { href: '/camera-roll/', label: 'Camera Roll' },
];
---
<header class="masthead">
  <div class="home-wrap">
    <div class="mast-row">
      <a class="wordmark" href="/">The Caddie Chat</a>
      <nav class="mast-nav" aria-label="Primary">
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>
</header>
{/* Measured here, before the hero is parsed, so the hero copy clears the
    masthead with no jump. On phones the links wrap to a second row, so the
    height is not a constant. Hero.astro falls back to --nav-height without it. */}
<script is:inline data-astro-rerun>
  (function () {
    function measure() {
      var m = document.querySelector('.masthead');
      if (m) document.documentElement.style.setProperty('--mast-h', m.offsetHeight + 'px');
    }
    measure();
    if (!window.__mastheadBound) {
      window.__mastheadBound = true;
      window.addEventListener('resize', measure, { passive: true });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
    }
  })();
</script>

<style>
  .masthead {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    color: #fff;
  }
  .masthead::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: -55%;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom,
      rgba(28,28,28,0.5) 0%, rgba(28,28,28,0.26) 50%,
      rgba(28,28,28,0.08) 80%, rgba(28,28,28,0) 100%);
  }
  .mast-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    flex-wrap: wrap;
    padding: 1.2rem 0 0.8rem;
  }
  .wordmark {
    font: 500 1.65rem/1 var(--font-display);
    letter-spacing: -0.012em;
    white-space: nowrap;
    padding: 0.5rem 0; /* tap area */
    color: #fff;
    text-shadow: 0 1px 14px rgba(0,0,0,0.28);
  }
  .mast-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.3rem;
  }
  .mast-nav a {
    display: inline-block;
    position: relative;
    font: 500 0.74rem/1 var(--font-body);
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.88);
    text-shadow: 0 1px 10px rgba(0,0,0,0.35);
    padding: 0.35rem 0;
    border-bottom: 1px solid transparent;
    transition: color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }
  /* tap area for tablets (the links are 24px tall above the phone breakpoint); no layout change */
  .mast-nav a::after {
    content: '';
    position: absolute;
    inset: -10px -8px;
  }
  .mast-nav a:hover {
    color: #fff;
    border-bottom-color: #fff;
  }
  .masthead a:focus-visible {
    outline-color: #fff;
  }

  @media (max-width: 760px) {
    .mast-row { padding: 0.75rem 0 0.4rem; gap: 0 2rem; }
    .mast-nav ul { gap: 0 1.3rem; }
    /* 44px-tall tap targets on phones */
    .mast-nav a { font-size: 0.68rem; letter-spacing: 0.14em; padding: 1rem 0; }
  }
  /* Phones: the four links hold one row, spread edge to edge under the wordmark
     (they would otherwise wrap and strand the last one on its own line). */
  @media (max-width: 520px) {
    .mast-nav { flex: 1 0 100%; }
    .mast-nav ul { flex-wrap: nowrap; justify-content: space-between; gap: 0 0.5rem; }
    .mast-nav a { font-size: clamp(0.56rem, 2.75vw, 0.68rem); letter-spacing: 0.1em; white-space: nowrap; }
  }
</style>
